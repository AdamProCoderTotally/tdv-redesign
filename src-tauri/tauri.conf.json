{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tower Defence V",
  "version": "0.2.17",
  "identifier": "com.adamdalisanskas.tdv",
  "build": {
    "beforeDevCommand": "node scripts/sync-dist.js",
    "beforeBuildCommand": "node scripts/sync-dist.js --minify",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Tower Defence V",
        "width": 1920,
        "height": 1080
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://tdv-cloud-save.adamdalisanskas.workers.dev"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/AdamProCoderTotally/tower-defence-v/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNCNjgyQUNGMDIxNTM2NkUKUldSdU5oVUN6eXBvTzFYTWJ3eUc4blREV0pZUkxZOHFmcldCM1VRM0huWXhGZDFrb0dycGtTa0IK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
